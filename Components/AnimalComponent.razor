@using ClassReview.Model;

<h2>個別の動物たち</h2>

<section>
    <h3>鳥の場合</h3>

    <p>クラス Animal とインターフェイス ISpawnable を実装するクラス Bird 型のインスタンスを作成する。</p>
    <p>クラス Bird を new して Bird 型の変数に代入する。</p>

    <ul>
        <li>名前 : @pea.Name</li>
        <li>HP : @pea.Hp</li>
        <li>メッセージ : @peaMessage</li>
    </ul>
    <p><button type="button" @onclick="peaEat">食べる</button></p>
    <p><button type="button" @onclick="peaFight">戦う</button></p>
    <p><button type="button" @onclick="peaSpawn">孵化する</button></p>
    <p><button type="button" @onclick="peaSing">鳴く</button></p>
</section>

<section>
    <h3>魚の場合 (1)</h3>

    <p>クラス Animal とインターフェイス ISpawnable を実装するクラス Fish 型のインスタンスを作成する。</p>
    <p>クラス Fish を new して Animal 型の変数に代入する。</p>
    <p>Animal 型の変数に代入しているため、Fish の固有のメソッドや、インターフェイス ISpawnable のメソッドは利用できない。</p>

    <ul>
        <li>名前 : @uo.Name</li>
        <li>HP : @uo.Hp</li>
        <li>メッセージ : @uoMessage</li>
    </ul>
    <p><button type="button" @onclick="() => this.uoMessage = this.uo.Eat()">食べる</button></p>
    <p><button type="button" @onclick="() => this.uoMessage = this.uo.Fight()">戦う</button></p>
    <p><button type="button" @onclick='() => this.uoMessage = "産めないんです"'>孵化する</button></p>
</section>

<section>
    <h3>魚の場合 (2)</h3>

    <p>クラス Animal とインターフェイス ISpawnable を実装するクラス Fish 型のインスタンスを作成する。</p>
    <p>クラス Fish を new して ISpawnable 型の変数に代入する。</p>
    <p>インターフェイス ISpawnable に存在するメソッド Spawn() 以外何も実行できない。</p>

    <ul>
        <li>名前 : ?</li>
        <li>HP : ?</li>
        <li>メッセージ : @fuguMessage</li>
    </ul>
    <p><button type="button" @onclick='() => this.fuguMessage = "食べれないんです"'>食べる</button></p>
    <p><button type="button" @onclick='() => this.fuguMessage = "戦えないんです"'>戦う</button></p>
    <p><button type="button" @onclick="() => this.fuguMessage = this.fugu.Spawn()">孵化する</button></p>
</section>

<h2>動物たちのリスト</h2>

<section>
    <h3>動物たちの場合</h3>

    <p>Animal 型のインスタンスを要素とするリスト List&lt;Animal&gt; を作成する。</p>
    <p>クラス Fish と Bird と Lion をそれぞれ new してリストに追加する。</p>

    <ul>
        <li>メッセージ : @animalMessage</li>
    </ul>

    <table>
        <thead>
            <tr>
                <th>名前</th>
                <th>体力</th>
                <th>食事ボタン</th>
                <th>戦闘ボタン</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Animal animal in this.animals)
            {
                <tr>
                    <td>@animal.Name</td>
                    <td>@animal.Hp</td>
                    <td><button @onclick="() => this.animalMessage = animal.Eat()">食べる</button></td>
                    <td><button @onclick="() => this.animalMessage = animal.Fight()">戦う</button></td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    /// <summary>
    /// 鳥のインスタンス
    /// </summary>
    private Bird pea = new Bird("ピーちゃん", 20);
    /// <summary>
    /// 鳥のメッセージ
    /// </summary>
    private string peaMessage;
    /// <summary>
    /// 魚のインスタンス
    /// </summary>
    private Animal uo = new Fish("うおくん", 15);
    /// <summary>
    /// 魚のメッセージ
    ///
    private string uoMessage;
    /// <summary>
    /// 魚のインスタンス 2
    /// </summary>
    private ISpawnable fugu = new Fish("ふぐちん", 5);
    /// <summary>
    /// 魚のメッセージ 2
    /// </summary>
    private string fuguMessage;
    /// <summary>
    /// 動物たちのリスト
    /// </summary>
    private List<Animal> animals = new List<Animal>()
    {
        new Fish("出目太郎", 5),
        new Bird("ピヨちゃん", 10),
        new Lion("雷太", 30),
    };
    /// <summary>
    /// 動物たちのメッセージ
    /// </summary>
    private string animalMessage;

    /// <summary>
    /// 鳥が食べる
    /// </summary>
    private void peaEat()
    {
        this.peaMessage = this.pea.Eat();
    }

    /// <summary>
    /// 鳥が戦う
    /// </summary>
    private void peaFight()
    {
        this.peaMessage = this.pea.Fight();
    }

    /// <summary>
    /// 鳥が孵化する
    /// </summary>
    private void peaSpawn()
    {
        this.peaMessage = this.pea.Spawn();
    }

    /// <summary>
    /// 鳥が鳴く
    /// </summary>
    private void peaSing()
    {
        this.peaMessage = this.pea.Sing();
    }
}
