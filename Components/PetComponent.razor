@using Model;

<p>クラス Pet を使って、以下のことを学習します。</p>
<ul>
    <li>
        クラスのメンバたち
        <ul>
            <li>
                データ
                <ul>
                    <li>フィールド : 基本的にはすべて private 修飾する</li>
                    <li>プロパティ : 外部からのアクセスを制御する。 get と set の必要なもののみ実装する</li>
                </ul>
            </li>
            <li>
                処理
                <ul>
                    <li>メソッド : 引数と戻り値を持つ。引数の型・または引数の数が異なる場合は、同一名のメソッドを複数定義できる（オーバロード）</li>
                    <li>コンストラクタ : new するときにのみ呼び出される特別なメソッド。クラス名と同一名にし、戻り値はもたない</li>
                </ul>
            </li>
        </ul>
    </li>
</ul>

<section>
    <h2>ペット「きなこ」の場合</h2>
    <p>クラス Pet を new してインスタンス「きなこ」を作成します。</p>
    <ul>
        <li>体力 : @kinako.Hp</li>
        <li>現在のエサの残り : @Pet.FeedCount</li>
        <li>メッセージ : @this.kinakoMessage</li>
    </ul>
    <p><button type="button" @onclick="() => this.kinakoMessage = this.kinako.Eat()">食べる</button></p>
    <p><button type="button" @onclick="() => this.kinakoMessage = this.kinako.Play()">芸をする</button></p>
</section>

<section>
    <h2>ペットたちの List の場合</h2>
    <p>ペットたちのリストを作成します。</p>
    <p>static 修飾された feedCount はすべてのペットたち（「きなこ」も含めて）で共有されています。</p>
    <ul>
        <li>現在のエサの残り : @Pet.FeedCount</li>
        <li>メッセージ : @this.message</li>
    </ul>
    <table>
        <thead>
            <tr>
                <th>名前</th>
                <th>体力</th>
                <th>食事ボタン</th>
                <th>芸ボタン</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Pet selectedPet in this.selectedPets)
            {
                <tr>
                    <td>@selectedPet.Name</td>
                    <td>@selectedPet.Hp</td>
                    <td><button @onclick="() => this.Eat(selectedPet)">食べる</button></td>
                    <td><button @onclick="() => this.Play(selectedPet)">芸をする</button></td>
                </tr>
            }
        </tbody>
    </table>

    <p><button type="button" @onclick="this.OrderByHp">HP の昇順で並べる</button></p>
    <p><button type="button" @onclick="this.OrderByHpDescending">HP の降順で並べる</button></p>
    <p><button type="button" @onclick="this.WhereGreaterThanHp5">HP 5 より大きいペットを表示</button></p>

</section>

@code {
    /// <summary>
    /// きなこ
    /// </summary>
    private Pet kinako = new Pet("きなこ", 18);
    /// <summary>
    /// きなこ用のメッセージ
    /// </summary>
    private string kinakoMessage = "";
    /// <summary>
    /// 初期化用
    /// </summary>
    private List<Pet> pets;
    /// <summary>
    /// 表示用
    /// </summary>
    private List<Pet> selectedPets;
    /// <summary>
    /// 表示用メッセージ
    /// </summary>
    private string message = "";

    /// <summary>
    /// 初期化
    /// </summary>
    protected override void OnInitialized()
    {
        this.pets = new List<Pet>
        {
            new Pet("ポチ", 10),
            new Pet("タマ", 8),
            new Pet("クロ", 12),
        };
        this.selectedPets = this.pets;
    }

    /// <summary>
    /// 全ペットを HP の昇順で並び替える
    /// </summary>
    private void OrderByHp()
    {
        this.selectedPets = this.pets.OrderBy(pet => pet.Hp).ToList();
    }

    /// <summary>
    /// 全ペットを HP の降順で並び替える
    /// </summary>
    private void OrderByHpDescending()
    {
        this.selectedPets = this.pets.OrderByDescending(pet => pet.Hp).ToList();
    }

    /// <summary>
    /// HP 5 より大きいペットを抽出する
    /// </summary>
    private void WhereGreaterThanHp5()
    {
        this.selectedPets = this.pets.Where(pet => 5 < pet.Hp)
            .OrderBy(pet => pet.Hp).ToList();
    }

    /// <summary>
    /// ペットが食事をする
    /// </summary>
    /// <param name="pet">ペット</param>
    private void Eat(Pet pet)
    {
        this.message = pet.Eat();
    }

    /// <summary>
    /// ペットが芸をする
    /// </summary>
    /// <param name="pet">ペット</param>
    private void Play(Pet pet)
    {
        this.message = pet.Play();
    }
}
